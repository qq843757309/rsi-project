{
  "type": "object",
  "properties": {
    "payload_version": {
      "const": "1.0.0"
    },
    "asset_id": {
      "type": "string",
      "format": "uuid"
    },
    "asset_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "asset_type": {
      "enum": [
        "FILE",
        "TABLE",
        "DATASET",
        "SEGMENT",
        "MEMORY",
        "MODEL_ARTIFACT",
        "CHECKPOINT"
      ]
    },
    "scope": {
      "type": "object",
      "properties": {
        "team_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "team_id",
        "project_id"
      ],
      "additionalProperties": false
    },
    "producer_id": {
      "type": "string",
      "minLength": 1
    },
    "owner_principal": {
      "type": "string",
      "minLength": 1
    },
    "classification": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "system_id": {
          "type": "string",
          "minLength": 1
        },
        "source_key": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "object"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "system_id",
        "source_key",
        "observed_at"
      ],
      "additionalProperties": false
    },
    "contract_ref": {
      "type": "object",
      "properties": {
        "contract_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "contract_id",
        "version"
      ],
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "STAGING",
        "VERIFIED",
        "PUBLISHED",
        "QUARANTINED",
        "WITHDRAWN"
      ]
    },
    "quality_state": {
      "enum": [
        "PASS",
        "FAIL",
        "WARN",
        "UNKNOWN"
      ]
    },
    "policy_ref": {
      "type": "string",
      "minLength": 1
    },
    "storage_ref": {
      "type": "string",
      "format": "uri"
    },
    "content": {
      "type": "object",
      "properties": {
        "hash_algorithm": {
          "const": "sha256"
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0
        },
        "mime_type": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "hash_algorithm",
        "hash",
        "byte_size",
        "mime_type"
      ],
      "additionalProperties": false
    },
    "schema_ref": {
      "type": "string",
      "minLength": 1
    },
    "parent_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "extensions": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_]{2,63}$": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "payload_version",
    "asset_id",
    "asset_version_id",
    "asset_type",
    "scope",
    "producer_id",
    "owner_principal",
    "classification",
    "source",
    "contract_ref",
    "status",
    "quality_state",
    "policy_ref",
    "created_at"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "asset_type": {
            "enum": [
              "FILE",
              "MODEL_ARTIFACT",
              "CHECKPOINT"
            ]
          }
        }
      },
      "then": {
        "required": [
          "storage_ref",
          "content"
        ]
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rsi:schema:asset:1.0.0",
  "title": "RSI Asset Version Envelope"
}
